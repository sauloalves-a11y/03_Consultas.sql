SELECT
    Aluno.id_aluno,
    Aluno.nome AS aluno,
    Aluno.email,
    Curso.nome AS curso
FROM Aluno
INNER JOIN Curso
    ON Aluno.id_curso = Curso.id_curso;















SELECT
    Turma.identificacao AS turma,
    Turma.periodo,
    Disciplina.nome AS disciplina,
    Professor.nome AS professor
FROM Turma
INNER JOIN Disciplina
    ON Turma.id_disciplina = Disciplina.id_disciplina
INNER JOIN Professor
    ON Turma.id_professor = Professor.id_professor;
    
    
    
    
    
    
    
    
    
    
    
    
    
SELECT
    Matricula.id_matricula,
    Aluno.nome AS aluno,
    Curso.nome AS curso,
    Turma.identificacao AS turma,
    Disciplina.nome AS disciplina,
    Matricula.data_matricula,
    Matricula.status
FROM Matricula
INNER JOIN Aluno
    ON Matricula.id_aluno = Aluno.id_aluno
INNER JOIN Curso
    ON Aluno.id_curso = Curso.id_curso
INNER JOIN Turma
    ON Matricula.id_turma = Turma.id_turma
INNER JOIN Disciplina
    ON Turma.id_disciplina = Disciplina.id_disciplina
ORDER BY Aluno.nome;















SELECT
    Turma.identificacao AS turma,
    Disciplina.nome AS disciplina,
    COUNT(Matricula.id_matricula) AS total_matriculas
FROM Turma
INNER JOIN Disciplina
    ON Turma.id_disciplina = Disciplina.id_disciplina
LEFT JOIN Matricula
    ON Turma.id_turma = Matricula.id_turma
GROUP BY
    Turma.identificacao,
    Disciplina.nome;
